#ifndef LEMON_CONFIG_H
#define LEMON_CONFIG_H

#define LEMON_VERSION "@PROJECT_VERSION@"

#cmakedefine LEMON_HAVE_LONG_LONG 1

#cmakedefine LEMON_CXX11 1

#cmakedefine LEMON_WIN32 1

#cmakedefine LEMON_HAVE_LP 1
#cmakedefine LEMON_HAVE_MIP 1
#cmakedefine LEMON_HAVE_GLPK 1
#cmakedefine LEMON_HAVE_CPLEX 1
#cmakedefine LEMON_HAVE_SOPLEX 1
#cmakedefine LEMON_HAVE_CLP 1
#cmakedefine LEMON_HAVE_CBC 1

#define LEMON_CPLEX_ 1
#define LEMON_CLP_ 2
#define LEMON_GLPK_ 3
#define LEMON_SOPLEX_ 4
#define LEMON_CBC_ 5

#cmakedefine LEMON_DEFAULT_LP LEMON_@LEMON_DEFAULT_LP@_
#cmakedefine LEMON_DEFAULT_MIP LEMON_@LEMON_DEFAULT_MIP@_

#cmakedefine LEMON_USE_PTHREAD 1
#cmakedefine LEMON_USE_WIN32_THREADS 1

#cmakedefine LEMON_SHARED_LIBRARY 1

/* the declaration of a datum of the library, which whoever uses LEMON as a
   DLL imports from it (its functions are exported without a mark) */
#if defined( _WIN32 ) && defined( LEMON_SHARED_LIBRARY )
 #ifdef LEMON_BUILDING_LIBRARY
  #define LEMON_DATA __declspec( dllexport )
 #else
  #define LEMON_DATA __declspec( dllimport )
 #endif
#else
 #define LEMON_DATA
#endif

/* a constant of namespace scope, inline from C++17, which gives it external
   linkage, so that the module lemon exports it and its templates may use
   it; a const one, of internal linkage, before */
#if __cplusplus >= 201703L || \
    ( defined( _MSVC_LANG ) && _MSVC_LANG >= 201703L )
 #define LEMON_CONSTANT inline constexpr
#else
 #define LEMON_CONSTANT const
#endif


#endif
